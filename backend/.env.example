# Copy to backend/.env for local runs. Every setting is optional except in production.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=climate_hazards
# STORAGE=memory           # skip Mongo entirely (nothing persisted)

# Comma separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Behind a proxy that appends the client IP to X-Forwarded-For (Render: 1)
TRUSTED_PROXY_HOPS=0
# Or name a header the platform sets and clients can't forge
CLIENT_IP_HEADER=

# Share of Open-Meteo's free tier this instance may use (weighted calls)
OPENMETEO_MINUTE_BUDGET=550
OPENMETEO_HOUR_BUDGET=4500
OPENMETEO_DAY_BUDGET=9000
